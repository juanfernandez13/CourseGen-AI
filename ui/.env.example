# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis no
# painel da Vercel, em Settings → Environment Variables, para produção.

# Chave do Gemini usada quando a requisição não traz o header X-Gemini-Key.
GEMINI_KEY=""

# OPCIONAL. Modelo principal e, separados por vírgula, os que entram quando ele
# fica indisponível (503) ou sem cota. Sem elas: gemini-3.5-flash e, de reserva,
# gemini-3.5-flash-lite e depois gemini-3.8-flash. Um ID que a chave não enxerga
# (404) é pulado.
# GEMINI_MODEL=""
# GEMINI_FALLBACK_MODELS=""

# OPCIONAL. Cifra o cookie de sessão do Moodle (aba "Datas das aulas" e o envio
# do Cadastro em lote). Sem ela o app funciona igual, guardando a sessão do
# Moodle em texto claro no cookie httpOnly.
#
# O que a cifra acrescenta: sem ela, quem abre o DevTools ou copia o perfil do
# navegador lê o valor e usa aquela sessão do Moodle fora daqui, sem senha. O
# httpOnly cobre XSS, não acesso à máquina.
#
# Gere uma com:  openssl rand -hex 32
#
# Definir ou trocar o valor invalida as sessões abertas — só refazer o login.
MOODLE_SESSION_SECRET=""

# Base do Moodle. Sem ela, https://ead.ifce.edu.br/
MOODLE_URL=""

# Ativa o upload direto do navegador para o Vercel Blob. Sem o token, os
# arquivos vão no corpo da requisição — o que só funciona local, porque a Vercel
# rejeita corpo acima de 4,5 MB antes da função executar.
BLOB_READ_WRITE_TOKEN=""
