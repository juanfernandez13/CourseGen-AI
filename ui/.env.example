# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis no
# painel da Vercel, em Settings → Environment Variables, para produção.

# Chave do Gemini usada quando a requisição não traz o header X-Gemini-Key.
GEMINI_KEY=""

# Cifra o cookie de sessão do Moodle (abas "Datas das aulas" e o envio do
# Cadastro em lote). OBRIGATÓRIA EM PRODUÇÃO: sem ela essas telas respondem 503,
# porque a sessão do Moodle não pode ser guardada em texto claro.
#
# Gere uma com:  openssl rand -hex 32
#
# Trocar o valor invalida as sessões abertas — os usuários só precisam entrar de
# novo, nada é perdido.
MOODLE_SESSION_SECRET=""

# Base do Moodle. Sem ela, https://ead.ifce.edu.br/
MOODLE_URL=""

# Ativa o upload direto do navegador para o Vercel Blob. Sem o token, os
# arquivos vão no corpo da requisição — o que só funciona local, porque a Vercel
# rejeita corpo acima de 4,5 MB antes da função executar.
BLOB_READ_WRITE_TOKEN=""
